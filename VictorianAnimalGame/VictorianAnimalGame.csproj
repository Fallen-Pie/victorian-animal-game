<Project Sdk="Godot.NET.Sdk/4.6.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>VictorianAnimalGame</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FixedMathSharp" Version="6.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Data\**" />
    <Content Include="Engine\Province\Zone\Zone.cs.uid" />
    <Content Include="View\**\*.gdshader" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Engine\Modifiers\Production\" />
    <Folder Include="Engine\Time\Processing\" />
  </ItemGroup>
</Project>