<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>VictorianAnimalGame</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Data\Goods\Fish.yaml" />
    <Content Include="Data\Goods\Radio.yaml" />
    <Content Include="Data\Goods\Wood.yaml" />
    <Content Include="Data\Species\Beaver.yaml" />
    <Content Include="Data\Species\Otter.yaml" />
    <Content Include="Data\Species\Raccoon.yaml" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Engine\Province\ProvinceBuilder\" />
  </ItemGroup>
</Project>